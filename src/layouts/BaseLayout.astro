---
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "inherit", overlap = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    {
      /* Marks the page as scripted before it paints, so src/styles/motion.css
         can hold back what src/scripts/motion.ts is about to animate. Without
         it — JavaScript blocked, or a slow network — nothing is ever hidden. */
    }
    <script is:inline>
      document.documentElement.classList.add("motion");
    </script>
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Nav overlap={overlap} />
    {
      /* `tabindex` so the jump moves focus here, not just the scroll position */
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "@/scripts/motion.ts";
    </script>
  </body>
</html>
