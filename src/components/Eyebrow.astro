---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * How the label is drawn.
   *
   * - `default` — a marker beside the text (default)
   * - `tag` — no marker; the text sits in a filled pill
   */
  variant?: "default" | "tag";
};

const {
  render = true,
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <p class="eyebrow_text text-style-small">
        <slot />
      </p>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      /* Reads as a tag: the brand color, with the text that sits on it */
      &.tag {
        background-color: var(--brand-500);
        color: var(--brand-text);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-main);
      }
    }

    /* Shape comes from tokens so a brand can swap the bar for a dot without
       touching this rule. Width and height are separate for that reason. */
    .eyebrow_marker {
      flex: none;
      width: var(--eyebrow-marker-width, var(--border-width));
      height: var(--eyebrow-marker-height, 0.75rem);
      border-radius: var(--eyebrow-marker-radius, 0);
      background-color: var(--eyebrow-marker-color, currentcolor);
    }
  }
</style>
