---
import Img from "@/components/Img.astro";
import Heading from "@/components/Heading.astro";
import Button from "@/components/Button.astro";
import ctaBackground from "@/assets/images/cta-background.png";
import { SITE_NAME, SITE_SOCIALS } from "@/consts.ts";
---

<footer class="footer_wrap theme-dark">
  <div class="footer_background">
    <Img src={ctaBackground} alt="" />
  </div>
  <div class="footer_inner">
    <div class="footer_cta">
      <Heading tag="h2" variant="display" class="footer_heading">
        Let&rsquo;s create<br />the remarkable
      </Heading>
      <Button element="link" href="/contact">Get in Touch</Button>
    </div>
    <div class="footer_bottom">
      <nav aria-label="Social">
        <ul class="footer_links">
          {
            SITE_SOCIALS.map(({ label, href }) => (
              <li>
                <a
                  class="footer_link"
                  href={href}
                  rel="me noopener"
                  target="_blank"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="footer_copyright text-style-small">
        &copy;<span id="year">{new Date().getFullYear()}</span>&#160;{SITE_NAME}
      </p>
    </div>
  </div>
</footer>

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    /* The closing call to action and the small print share one ground, so the
       background image runs behind both. */
    .footer_wrap {
      position: relative;
      display: flex;
      justify-content: center;
      min-height: min(100svh, 57rem);
      padding: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      overflow: clip;
      isolation: isolate;
    }

    .footer_background {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      & > .image {
        width: 100%;
        height: 100%;
      }
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--section-space-medium);
    }

    /* Centred in what is left once the bottom row has taken its height. */
    .footer_cta {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex-grow: 1;
      gap: var(--space-7);
      text-align: center;
    }

    .footer_heading {
      max-width: 20ch;
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3) var(--space-6);
    }

    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: var(--text-small);
    }

    .footer_link {
      color: inherit;
      text-decoration: none;
      text-underline-offset: 0.4em;
      text-decoration-thickness: var(--border-width);
      transition: opacity 200ms;
      @media (hover: hover) {
        &:hover {
          text-decoration: underline;
          opacity: 0.7;
        }
      }
    }
  }
</style>
