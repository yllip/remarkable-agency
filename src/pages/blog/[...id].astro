---
import { render } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import RichText from "@/components/RichText.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Img from "@/components/Img.astro";
import Grid from "@/components/Grid.astro";
import PostCard from "@/components/PostCard.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { getPosts, postHref, type Post } from "@/utils/blog.ts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const {
  title,
  description,
  tag,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
} = post.data;

/* Three more to read, newest first, minus the one being read. */
const more = (await getPosts())
  .filter((entry) => entry.id !== post.id)
  .slice(0, 3);
---

<Layout title={title} description={description} type="article" theme="dark">
  {/* ---------- Post ---------- */}
  <Section paddingBottom="small" gap="7">
    <div class="post-header">
      <Eyebrow variant="tag" data-intro>{tag}</Eyebrow>
      <Heading
        tag="h1"
        variant="h2"
        maxWidth={30}
        data-split="lines"
        data-intro
      >
        {title}
      </Heading>
      <Paragraph variant="large" maxWidth={60} data-intro
        >{description}</Paragraph
      >
      <p class="post-header_meta text-style-small" data-intro>
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <>
              {" · Updated "}
              <FormattedDate date={updatedDate} />
            </>
          )
        }
      </p>
    </div>

    {
      heroImage && (
        <Img
          src={heroImage}
          alt={heroImageAlt}
          variant="constrained"
          sizes="(min-width: 64rem) 64rem, 100vw"
          loading="eager"
          fetchPriority="high"
          class="post-hero"
          data-reveal
        />
      )
    }

    {
      /* The contents come before the post in the markup, so a reader moving
         through the page by keyboard or screen reader meets the list of
         sections before the sections themselves. Wide enough, and it moves to
         the column beside them. */
    }
    <div class="post-layout">
      <TableOfContents headings={headings} maxDepth={2} />
      <RichText class="post-body" maxWidth={70}>
        <Content />
      </RichText>
    </div>

    <ButtonWrapper>
      <Button element="link" href="/blog" variant="secondary">
        All posts
      </Button>
    </ButtonWrapper>
  </Section>

  {/* ---------- More reading ---------- */}
  <Section render={more.length > 0} theme="light" paddingBottom="large" gap="6">
    <Heading tag="h2" variant="h3" data-split="lines">Keep reading</Heading>
    <Grid xsmall={1} medium={2} large={3} class="post-more">
      {
        more.map((entry) => (
          <PostCard
            tag={entry.data.tag}
            heading={entry.data.title}
            date={entry.data.pubDate}
            href={postHref(entry)}
            data-reveal
          />
        ))
      }
    </Grid>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .post-header {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
    }

    /* The date closes the header, so it is set apart from the standfirst. */
    .post-header_meta {
      margin: 0;
      color: color-mix(in lab, currentcolor 60%, transparent);
    }

    .post-hero {
      width: 100%;
      border-radius: var(--radius-main);
      aspect-ratio: 16 / 9;
    }

    /* The post and its contents. One column until there is room for two, at
       which point the list takes the space the 70ch measure leaves over and
       the post keeps the place it already had. */
    .post-layout {
      width: 100%;
      display: grid;
      gap: var(--space-6);

      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 1fr) minmax(11rem, 17rem);
        column-gap: var(--section-space-small);
        align-items: start;

        & > .post-body {
          grid-area: 1 / 1;
        }

        /* Stays with the reader for the length of the post, and scrolls
           within itself rather than past the bottom of the screen. */
        & > .toc {
          --_ring: calc(var(--focus-offset) + var(--focus-width));
          grid-area: 1 / 2;
          position: sticky;
          top: calc(var(--nav-height) + var(--space-5));
          max-height: calc(100svh - var(--nav-height) - var(--space-5) * 2);
          /* A scroll box clips at its own edge, and a focused entry's ring
             sits outside the link. Inset by as much as the ring stands proud,
             then pulled back level, so the list has not moved. */
          padding: var(--_ring);
          margin: calc(var(--_ring) * -1);
          overflow: auto;
        }
      }
    }

    /* Clear of the bar the section headings are jumped under. */
    .post-body :is(h2, h3, h4, h5, h6) {
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
    }

    /* Cards in a row match heights so the dates along the bottom line up. */
    .post-more {
      align-items: stretch;
    }
  }
</style>
